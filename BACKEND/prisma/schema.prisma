generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  password             String?
  role                 UserRole
  googleId             String?          @unique
  firstName            String?
  lastName             String?
  avatarUrl            String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @default(now()) @updatedAt
  organization         Organization?
  volunteer            Volunteer?
  verifiedSkills       VolunteerSkill[] @relation("SkillVerifiedBy")

  @@index([email])
  @@index([googleId])
}

model Organization {
  id              String    @id @default(cuid())
  name            String
  contact         String?
  createdAt       DateTime  @default(now())
  description     String?
  history         String?
  logoUrl         String?
  mission         String?
  updatedAt       DateTime  @default(now()) @updatedAt
  userId          String    @unique
  website         String?
  competencies    String[]
  dateOfCreation  DateTime?
  fieldOfActivity String?
  location        String?
  logo            String?
  missions        Mission[]
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Volunteer {
  id                    String           @id @default(cuid())
  createdAt             DateTime         @default(now())
  firstName             String
  lastName              String
  availabilities        String?
  bio                   String?
  interests             String[]
  totalHoursVolunteered Int              @default(0)
  updatedAt             DateTime         @default(now()) @updatedAt
  userId                String           @unique
  photo                 String?
  applications          Application[]
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                VolunteerSkill[]

  @@index([userId])
}

model Skill {
  id                   String           @id @default(cuid())
  name                 String           @unique
  createdAt            DateTime         @default(now())
  description          String?
  requiresVerification Boolean          @default(false)
  updatedAt            DateTime         @default(now()) @updatedAt
  missionSkills        MissionSkill[]
  volunteerSkills      VolunteerSkill[]

  @@index([name])
}

model VolunteerSkill {
  id             String                  @id @default(cuid())
  volunteerId    String
  skillId        String
  status         SkillVerificationStatus @default(PENDING)
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt
  skill          Skill                   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  verifiedByUser User?                   @relation("SkillVerifiedBy", fields: [verifiedBy], references: [id])
  volunteer      Volunteer               @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  certificate    String?

  @@unique([volunteerId, skillId])
  @@index([volunteerId])
  @@index([skillId])
}

model SDG {
  id          Int       @id
  title       String
  description String
  iconUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  missions    Mission[]
}

model Mission {
  id                 String          @id @default(cuid())
  title              String
  description        String
  location           String
  organizationId     String
  createdAt          DateTime        @default(now())
  endDate            DateTime        @default(now())
  isArchived         Boolean         @default(false)
  isPublished        Boolean         @default(true)
  sdgId              Int?
  startDate          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt
  volunteersAccepted Int             @default(0)
  volunteersNeeded   Int             @default(0)
  image              String?
  applications       Application[]
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sdg                SDG?            @relation(fields: [sdgId], references: [id])
  skills             MissionSkill[]
  participations     Participation[]

  @@index([organizationId])
  @@index([sdgId])
  @@index([isPublished])
  @@index([location])
}

model MissionSkill {
  id             String   @id @default(cuid())
  missionId      String
  skillId        String
  levelRequired  String?
  mustBeVerified Boolean  @default(false)
  createdAt      DateTime @default(now())
  mission        Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  skill          Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([missionId, skillId])
  @@index([missionId])
  @@index([skillId])
}

model Application {
  id          String            @id @default(cuid())
  volunteerId String
  missionId   String
  createdAt   DateTime          @default(now())
  appliedAt   DateTime          @default(now())
  message     String?
  reviewedAt  DateTime?
  updatedAt   DateTime          @default(now()) @updatedAt
  status      ApplicationStatus @default(PENDING)
  mission     Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  volunteer   Volunteer         @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, missionId])
  @@index([volunteerId])
  @@index([missionId])
  @@index([status])
}

model Participation {
  id             String   @id @default(cuid())
  missionId      String
  volunteerId    String
  hoursCompleted Int      @default(0)
  validatedAt    DateTime @default(now())
  validatedBy    String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  mission        Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, volunteerId])
  @@index([missionId])
  @@index([volunteerId])
}

enum UserRole {
  ORGANIZATION
  VOLUNTEER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SkillVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}
