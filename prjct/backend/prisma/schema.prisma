generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Types: Organization and Volunteer
enum UserRole {
  ORGANIZATION
  VOLUNTEER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SkillVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Main User Model
model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String?
  role                 UserRole
  googleId             String?   @unique
  firstName            String?
  lastName             String?
  avatarUrl            String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  // Relations
  organization   Organization?
  volunteer      Volunteer?
  verifiedSkills VolunteerSkill[] @relation("SkillVerifiedBy")

  @@index([email])
  @@index([googleId])
}

// Organization Profile
model Organization {
  id          String   @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  mission     String?  @db.Text
  history     String?  @db.Text
  contact     String?
  website     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  missions Mission[]

  @@index([userId])
}

// Volunteer Profile
model Volunteer {
  id                    String   @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  bio                   String?  @db.Text
  interests             String[] @db.Text
  availabilities        String?  @db.Text
  totalHoursVolunteered Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  skills       VolunteerSkill[]
  applications Application[]

  @@index([userId])
}

// Skills Catalog
model Skill {
  id                   String   @id @default(cuid())
  name                 String   @unique
  description          String?  @db.Text
  requiresVerification Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  volunteerSkills VolunteerSkill[]
  missionSkills   MissionSkill[]

  @@index([name])
}

// VolunteerSkill (junction table)
model VolunteerSkill {
  id             String                  @id @default(cuid())
  volunteerId    String
  volunteer      Volunteer               @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill                   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  status         SkillVerificationStatus @default(PENDING)
  verifiedAt     DateTime?
  verifiedBy     String?
  verifiedByUser User?                   @relation("SkillVerifiedBy", fields: [verifiedBy], references: [id])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt

  @@unique([volunteerId, skillId])
  @@index([volunteerId])
  @@index([skillId])
}

// UN Sustainable Development Goals
model SDG {
  id          Int      @id
  title       String
  description String   @db.Text
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  missions Mission[]
}

// Mission (Volunteer Opportunity)
model Mission {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title              String
  description        String       @db.Text
  location           String
  startDate          DateTime     @default(now())
  endDate            DateTime     @default(now())
  volunteersNeeded   Int          @default(0)
  volunteersAccepted Int          @default(0)
  isPublished        Boolean      @default(false)
  isArchived         Boolean      @default(false)
  sdgId              Int?
  sdg                SDG?         @relation(fields: [sdgId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  skills         MissionSkill[]
  applications   Application[]
  participations Participation[]

  @@index([organizationId])
  @@index([sdgId])
  @@index([isPublished])
  @@index([location])
}

// MissionSkill
model MissionSkill {
  id             String   @id @default(cuid())
  missionId      String
  mission        Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  levelRequired  String?
  mustBeVerified Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([missionId, skillId])
  @@index([missionId])
  @@index([skillId])
}

// Application
model Application {
  id          String            @id @default(cuid())
  volunteerId String
  volunteer   Volunteer         @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  missionId   String
  mission     Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(PENDING)
  message     String?           @db.Text
  appliedAt   DateTime          @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@unique([volunteerId, missionId])
  @@index([volunteerId])
  @@index([missionId])
  @@index([status])
}

// Participation
model Participation {
  id             String   @id @default(cuid())
  missionId      String
  mission        Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  volunteerId    String
  hoursCompleted Int      @default(0)
  validatedAt    DateTime @default(now())
  validatedBy    String
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([missionId, volunteerId])
  @@index([missionId])
  @@index([volunteerId])
}
