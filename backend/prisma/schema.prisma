generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Types: Organization and Volunteer
enum UserRole {
  ORGANIZATION
  VOLUNTEER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SkillVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Main User Model
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?  // Hashed with bcrypt, Made optional for Google OAuth users
  role      UserRole
  googleId  String?  @unique
  firstName String?
  lastName  String?
  avatarUrl String?
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization?
  volunteer    Volunteer?

  @@index([email])
  @@index([googleId])
}

// Organization Profile
model Organization {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  mission     String?  @db.Text
  history     String?  @db.Text
  contact     String?
  website     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  missions Mission[]

  @@index([userId])
}

// Volunteer Profile
model Volunteer {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  bio                String?  @db.Text
  interests String[] @db.Text
 // Array of interests: environment, education, etc.
  availabilities     String?  @db.Text
  totalHoursVolunteered Int   @default(0) // Accumulated volunteer hours badge
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  skills        VolunteerSkill[]
  applications  Application[]

  @@index([userId])
}

// Skills Catalog
model Skill {
  id                   String  @id @default(cuid())
  name                 String  @unique
  description          String? @db.Text
  requiresVerification Boolean @default(false) // If true, needs admin verification
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  volunteerSkills VolunteerSkill[]
  missionSkills   MissionSkill[]

  @@index([name])
}

// Junction table: Volunteer + Skills with verification status
model VolunteerSkill {
  id            String                  @id @default(cuid())
  volunteerId   String
  volunteer     Volunteer               @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill                   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  status        SkillVerificationStatus @default(PENDING)
  verifiedAt    DateTime?
  verifiedBy    String?
  verifiedByUser User? @relation(fields: [verifiedBy], references: [id])
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([volunteerId, skillId])
  @@index([volunteerId])
  @@index([skillId])
}

// UN Sustainable Development Goals
model SDG {
  id          Int      @id // 1-17 for the 17 SDGs
  title       String
  description String   @db.Text
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  missions Mission[]
}

// Mission (Volunteer Opportunity)
model Mission {
  id                   String    @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                String
  description          String    @db.Text
  location             String
  startDate            DateTime
  endDate              DateTime
  volunteersNeeded     Int
  volunteersAccepted   Int       @default(0)
  isPublished          Boolean   @default(false)
  isArchived           Boolean   @default(false)
  sdgId                Int?      // UN SDG Goal
  sdg                  SDG?      @relation(fields: [sdgId], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  skills        MissionSkill[]
  applications  Application[]
  participations Participation[]

  @@index([organizationId])
  @@index([sdgId])
  @@index([isPublished])
  @@index([location])
}

// Junction table: Mission + Skills with verification requirement
model MissionSkill {
  id                   String  @id @default(cuid())
  missionId            String
  mission              Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  skillId              String
  skill                Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  levelRequired        String? // Optional: beginner, intermediate, advanced
  mustBeVerified       Boolean @default(false) // If true, blocks application if not verified
  createdAt            DateTime @default(now())

  @@unique([missionId, skillId])
  @@index([missionId])
  @@index([skillId])
}

// Application (Volunteer applies to Mission)
model Application {
  id          String            @id @default(cuid())
  volunteerId String
  volunteer   Volunteer         @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  missionId   String
  mission     Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(PENDING)
  message     String?           @db.Text // Optional message from volunteer
  appliedAt   DateTime          @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([volunteerId, missionId])
  @@index([volunteerId])
  @@index([missionId])
  @@index([status])
}

// Participation (Validated attendance with hours)
model Participation {
  id             String   @id @default(cuid())
  missionId      String
  mission        Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  volunteerId    String   // Reference to volunteer (not FK to allow flexibility)
  hoursCompleted Int      @default(0)
  validatedAt    DateTime @default(now())
  validatedBy    String   // Organization user ID who validated
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([missionId, volunteerId])
  @@index([missionId])
  @@index([volunteerId])
}